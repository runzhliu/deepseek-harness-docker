{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "service", "persistence", "workspace", "credentials", "networkPolicy"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy", "pullSecrets"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array" }
      }
    },
    "service": {
      "type": "object",
      "required": ["port"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "accessModes", "size"],
      "properties": {
        "enabled": { "type": "boolean" },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "size": { "type": "string", "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki)$" },
        "annotations": { "type": "object" }
      }
    },
    "workspace": {
      "type": "object",
      "required": ["existingClaim", "subPath"],
      "properties": {
        "existingClaim": { "type": "string" },
        "subPath": { "type": "string" }
      }
    },
    "credentials": {
      "type": "object",
      "required": ["existingSecret"],
      "properties": {
        "existingSecret": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": { "type": "array" }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 }
  }
}
