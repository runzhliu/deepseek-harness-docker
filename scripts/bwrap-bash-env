# shellcheck shell=bash
# Persistent per-workspace TMPDIR for the agent's shell, sourced through
# BASH_ENV before every dsh tool call (`bash -c`, confined when a sandbox
# backend is available).
#
# The bwrap profile gives each tool call a fresh, empty `--tmpfs /tmp` and
# binds only the session workspace read-write, so a scratch file written to
# /tmp is gone by the next call, and the container's small noexec /tmp cannot
# run what mktemp-based toolchains build. Point TMPDIR at <workspace>/.tmp
# instead: it lives on the workspace mount, so it survives between calls.
#
# Rules:
# - A TMPDIR that already names a writable directory is left alone.
# - Candidates are $HOME (upstream sets HOME=/workspace, the mount point) and
#   every directory from there down to $PWD; the first whose .tmp can really
#   be written wins. Nothing happens when HOME is unset or /, or when $PWD is
#   outside $HOME.
# - The write probe is a real append into .tmp/.dsh-tmpdir because `test -w`
#   alone cannot answer for every confinement backend.
# - Never fail, print or leak variables: every `bash -c` sources this, also
#   under `set -euo pipefail`. Under `bash -x` its own lines are not traced
#   (the guard below runs with stderr discarded), unless BASH_XTRACEFD points
#   the trace elsewhere. Builtins only on the hot path; mkdir runs once.
#
# A BASH_ENV of your own replaces this file; source it from there:
#   . /opt/deepseek-harness/bwrap-bash-env

{ __dsh_tmp_flags=$-; set +x; } 2>/dev/null

if ! { [ -d "${TMPDIR:-}" ] && [ -w "${TMPDIR:-}" ]; }; then
  __dsh_tmp_root=${HOME:-}
  __dsh_tmp_root=${__dsh_tmp_root%/}
  case $__dsh_tmp_root in
    */./* | */../* | */. | */.. | *//*) ;;
    /?*)
      case $PWD in
        */./* | */../* | */. | */.. | *//*) ;;
        "$__dsh_tmp_root" | "$__dsh_tmp_root"/?*)
          __dsh_tmp_dir=$__dsh_tmp_root
          __dsh_tmp_rest=${PWD#"$__dsh_tmp_root"}
          __dsh_tmp_rest=${__dsh_tmp_rest#/}
          while :; do
            if [ -w "$__dsh_tmp_dir" ] \
              && { [ -d "$__dsh_tmp_dir/.tmp" ] || mkdir -m 0700 "$__dsh_tmp_dir/.tmp" 2>/dev/null; } \
              && [ -w "$__dsh_tmp_dir/.tmp" ] \
              && { true >>"$__dsh_tmp_dir/.tmp/.dsh-tmpdir"; } 2>/dev/null; then
              export TMPDIR="$__dsh_tmp_dir/.tmp"
              break
            fi
            [ -n "$__dsh_tmp_rest" ] || break
            __dsh_tmp_dir=$__dsh_tmp_dir/${__dsh_tmp_rest%%/*}
            case $__dsh_tmp_rest in
              */*) __dsh_tmp_rest=${__dsh_tmp_rest#*/} ;;
              *) __dsh_tmp_rest= ;;
            esac
          done
          ;;
      esac
      ;;
  esac
fi

unset __dsh_tmp_root __dsh_tmp_rest __dsh_tmp_dir
case $__dsh_tmp_flags in
  *x*) unset __dsh_tmp_flags; set -x ;;
  *) unset __dsh_tmp_flags ;;
esac
