#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo "bubblewrap variant must start as root so it can make the container root mount private" >&2
  exit 125
fi

# Some Docker hosts expose / with shared propagation. Bubblewrap deliberately
# changes / to slave before creating its rootfs, which a nested user namespace
# cannot do to a mount owned by the outer namespace. Use the one capability
# granted by compose.bwrap.yaml for this single operation, then permanently
# drop to the base image's unprivileged account before DSH or model commands run.
mount --make-rprivate /

exec setpriv \
  --reuid=1000 \
  --regid=1000 \
  --clear-groups \
  --no-new-privs \
  -- "$@"
