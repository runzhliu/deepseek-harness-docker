# Copy this file to .env.lan and replace every deployment-specific value.
# Keep .env.lan private; it is ignored by Git.

# Bind the gateway to one exact server LAN address. Do not use 0.0.0.0: that
# would also publish DSH on VPN, Wi-Fi, cloud, or other unintended interfaces.
DSH_LAN_BIND_ADDRESS=192.168.1.10

# Prefer a local DNS record. A private IP literal also works. Enter only the
# host or IP: no scheme, path, or port.
DSH_LAN_HOST=dsh.home.arpa
# 8443 also works with ordinary rootless Docker/Podman users. Use 443 only
# when the host runtime is allowed to bind privileged ports.
DSH_LAN_HTTPS_PORT=8443

# Caddy Basic Auth. Generate the hash interactively with:
# docker run --rm -it docker.io/library/caddy:2.11.4-alpine caddy hash-password
DSH_LAN_USERNAME=dsh
# Single quotes keep the dollar signs in a bcrypt hash literal.
DSH_LAN_PASSWORD_HASH=

# Optional image/workspace overrides. The defaults remain the pinned release
# and an isolated named workspace volume.
DSH_IMAGE_REPOSITORY=docker.io/runzhliu/deepseek-harness
DSH_IMAGE_VERSION=0.1.7-alpha.1-r1
DSH_WORKSPACE=dsh-workspace
CADDY_IMAGE=docker.io/library/caddy:2.11.4-alpine
