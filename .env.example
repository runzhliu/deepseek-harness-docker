# Exact official @deepseek-ai/dsh version packaged by the image.
DSH_VERSION=0.1.0-rc.6

# Host loopback port. Do not change the bind address in compose.yaml.
DSH_PORT=3080

# Host loopback port for the interactive noVNC desktop.
DSH_DESKTOP_PORT=6080

# Absolute or relative host path exposed to the Agent as /workspace.
DSH_WORKSPACE=.

# Workspace file manager limits for directory listings, previews, and writes.
DSH_WORKSPACE_MAX_ENTRIES=2000
DSH_WORKSPACE_MAX_PREVIEW_BYTES=524288
DSH_WORKSPACE_MAX_WRITE_BYTES=1048576
